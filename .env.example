# Gmail SMTP Configuration (Password Reset & Authentication Emails)
# NOTE: Do NOT use your standard Gmail account password!
# Google requires a 16-character App Password (requires 2-Step Verification enabled):
# 1. Open Google Account: https://myaccount.google.com/security
# 2. Go to 2-Step Verification -> App passwords (https://myaccount.google.com/apppasswords)
# 3. Create an app named "StudyFlow" and copy the 16 characters (spaces are automatically stripped)
GMAIL_USER=rovicrosales14@gmail.com
GMAIL_APP_PASSWORD=replace_with_16_char_google_app_password
SMTP_FROM_NAME="StudyFlow Academic Planner"

# Database Connection (Neon PostgreSQL)
DATABASE_URL=

# JWT Authentication Secret (min 32 characters in production)
JWT_SECRET=

# Development / Presentation Demonstration Flags (strictly disabled in production)
ENABLE_DEV_RESET_FALLBACK=
SHOW_DEV_RESET_CODE_IN_UI=
VITE_API_BASE_URL=