# PostgreSQL connection string. Copy a fresh value from your database provider.
DATABASE_URL=""

# Unified Express/Vite server.
PORT=3000
VITE_API_BASE_URL="/api"

# Use a unique cryptographically random value of at least 32 characters.
JWT_SECRET=""

# Optional external services. Never commit live credentials.
GEMINI_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Optional S3-compatible object storage.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"

# Development-only password-reset helpers. Keep disabled outside local development.
ENABLE_DEV_RESET_FALLBACK=false
SHOW_DEV_RESET_CODE_IN_UI=false
